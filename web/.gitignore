# ───────────────────────────────
# OS / Editor Junk
# ───────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE settings
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# ───────────────────────────────
# Node / NPM
# ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package lock variations (optional)
package-lock.json
yarn.lock
pnpm-lock.yaml

# ───────────────────────────────
# Build Artifacts
# ───────────────────────────────
dist/
build/
coverage/
*.local

# React / Vite output
dist-ssr/

# ───────────────────────────────
# Amplify & AWS
# ───────────────────────────────

# Local sandbox outputs (safe to ignore)
amplify_outputs.json

# Amplify local state
amplify/.sandbox/
amplify/.temp/
amplify/.config/local-env-info.json
amplify/.config/local-aws-info.json
amplify/mock-data/
amplify/#current-cloud-backend/

# AWS CDK temp files
cdk.out/

# ───────────────────────────────
# Environment Variables (VERY IMPORTANT)
# Do NOT commit your secrets
# ───────────────────────────────
.env
.env.*
!.env.example

# ───────────────────────────────
# Test Outputs
# ───────────────────────────────
coverage/
.vitest/
.junit/

# ───────────────────────────────
# Misc
# ───────────────────────────────
*.log
*.pid
*.pid.lock